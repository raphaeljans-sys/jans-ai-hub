<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ch.jans.wissens-trigger</string>

    <!-- Ereignis-Trigger fuer gesaettigte Lern-Loops (Entscheid Raphael 26.07.2026).
         Prueft einmal taeglich, ob sich das Quellmaterial einer auf Ereignis-Trigger
         umgestellten KB geaendert hat, und faehrt nur dann deren Trainingslauf.
         Installation: cp in ~/Library/LaunchAgents/ und
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ch.jans.wissens-trigger.plist -->

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/daten/jans-ai-hub/scripts/wissens-trigger.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- BEWUSST KEINE StandardOutPath/StandardErrorPath auf /Volumes/daten:
         launchd legt diese Dateien selbst an, bevor der Job startet, und scheitert am
         SMB-Mount mit EX_CONFIG (78) — der Job laeuft dann NIE an (belegt 27.07.2026,
         beide Stationen; gleiche Falle wie Memory `project_launchd_tcc_smb`). Der
         funktionierende `ch.jans.vollgas-supervisor` fuehrt aus demselben Grund keine
         Log-Pfade. Das Script loggt selbst nach logbuch/wissens-trigger/trigger.log. -->
</dict>
</plist>
