<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ch.jans.speicher-waechter</string>

    <!-- Speicher-Waechter (Auftrag Raphael 28.07.2026 nach dem Speicher-Notstand).
         Prueft alle 30 Min den OneDrive-Footprint und den freien Speicher.
         Startet NUR OneDrive neu — nie Claude, nie Benutzer-Anwendungen.
         Installation:
           cp templates/launchd/ch.jans.speicher-waechter.plist ~/Library/LaunchAgents/
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ch.jans.speicher-waechter.plist -->

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>S="$HOME/Developer/jans-ai-hub/scripts/speicher-waechter.sh"; [ -f "$S" ] || S="/Volumes/daten/jans-ai-hub/scripts/speicher-waechter.sh"; [ -f "$S" ] || exit 0; exec /bin/bash "$S"</string>
    </array>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- BEWUSST KEINE StandardOutPath/StandardErrorPath auf /Volumes/daten:
         launchd legt diese Dateien selbst an, bevor der Job startet, und scheitert
         am SMB-Mount mit EX_CONFIG (78) — der Job laeuft dann NIE an (belegt
         27.07.2026, beide Stationen; Memory `project_launchd_tcc_smb`).
         Das Script loggt selbst nach logbuch/speicher/<Station>.log. -->
</dict>
</plist>
